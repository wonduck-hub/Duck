# C# coding standard configuration
# Based on the attached company draft derived from Pope Kim's C# coding standard.
#
# This file contains only rules that .editorconfig and the built-in .NET analyzers
# can express without changing the meaning of the written standard.

root = true

[*.cs]

#### Basic text and formatting rules ###########################################

# Source formatting 1: four spaces for indentation.
indent_style = space
indent_size = 4
tab_width = 4

# Keep files consistent across editors.
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# Source formatting 2: opening braces are placed on a new line.
csharp_new_line_before_open_brace = all

# Source formatting 3: always use braces, even for a single statement.
csharp_prefer_braces = true:warning
csharp_preserve_single_line_blocks = false
csharp_preserve_single_line_statements = false

#### Main standard: code-style rules #########################################

# Rule 9: fields that do not change after initialization should be readonly.
dotnet_style_readonly_field = true:warning

# Rule 20 (partial): report parameterless Get* methods that are suitable as
# properties. CA1024 cannot identify every hand-written getter/setter pair.
dotnet_diagnostic.CA1024.severity = warning

# Rule 39: avoid var. Anonymous types still require var and remain valid.
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# Rule 51: do not prefer object initializers.
dotnet_style_object_initializer = false:warning

# Rule 52: declare out variables before the argument list.
csharp_style_inlined_variable_declaration = false:warning

# Rule 53: do not use the null-coalescing expression.
dotnet_style_coalesce_expression = false:warning

# Rule 54: prefer a using statement/block over a using declaration.
csharp_prefer_simple_using_statement = false:warning

# Rule 55: write the type explicitly after new.
csharp_style_implicit_object_creation_when_type_is_apparent = false:warning

# Rule 57: use file-scoped namespaces.
csharp_style_namespace_declarations = file_scoped:warning

#### Main standard: naming rules #############################################

# IDE1006 must be warning or error for naming violations to be enforced during
# command-line builds as well as inside Visual Studio.
dotnet_diagnostic.IDE1006.severity = warning

# Rule 1: class and struct names use PascalCase.
dotnet_naming_rule.classes_and_structs_pascal_case.symbols = classes_and_structs
dotnet_naming_rule.classes_and_structs_pascal_case.style = pascal_case
dotnet_naming_rule.classes_and_structs_pascal_case.severity = warning

dotnet_naming_symbols.classes_and_structs.applicable_kinds = class, struct
dotnet_naming_symbols.classes_and_structs.applicable_accessibilities = *

# Rule 2: local variables and parameters use camelCase.
dotnet_naming_rule.parameters_camel_case.symbols = parameters
dotnet_naming_rule.parameters_camel_case.style = camel_case
dotnet_naming_rule.parameters_camel_case.severity = warning

dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *

dotnet_naming_rule.locals_camel_case.symbols = locals
dotnet_naming_rule.locals_camel_case.style = camel_case
dotnet_naming_rule.locals_camel_case.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_symbols.locals.applicable_accessibilities = local

# Rule 5: all methods use PascalCase.
dotnet_naming_rule.methods_pascal_case.symbols = methods
dotnet_naming_rule.methods_pascal_case.style = pascal_case
dotnet_naming_rule.methods_pascal_case.severity = warning

dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_symbols.methods.applicable_accessibilities = *

# Rule 6: constants use ALL_CAPS_SEPARATED_BY_UNDERSCORE.
dotnet_naming_rule.constants_upper_snake_case.symbols = constants
dotnet_naming_rule.constants_upper_snake_case.style = upper_snake_case
dotnet_naming_rule.constants_upper_snake_case.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.applicable_accessibilities = *
dotnet_naming_symbols.constants.required_modifiers = const

# Rule 8: static readonly fields used as constants use upper snake case.
dotnet_naming_rule.static_readonly_fields_upper_snake_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_upper_snake_case.style = upper_snake_case
dotnet_naming_rule.static_readonly_fields_upper_snake_case.severity = warning

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly

# Explicit intersections prevent private-field naming from overriding rules 6/8.
dotnet_naming_rule.private_constants_upper_snake_case.symbols = private_constants
dotnet_naming_rule.private_constants_upper_snake_case.style = upper_snake_case
dotnet_naming_rule.private_constants_upper_snake_case.severity = warning

dotnet_naming_symbols.private_constants.applicable_kinds = field
dotnet_naming_symbols.private_constants.applicable_accessibilities = private
dotnet_naming_symbols.private_constants.required_modifiers = const

dotnet_naming_rule.private_static_readonly_upper_snake_case.symbols = private_static_readonly_fields
dotnet_naming_rule.private_static_readonly_upper_snake_case.style = upper_snake_case
dotnet_naming_rule.private_static_readonly_upper_snake_case.severity = warning

dotnet_naming_symbols.private_static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly_fields.required_modifiers = static, readonly

# Rule 10: namespaces use PascalCase.
dotnet_naming_rule.namespaces_pascal_case.symbols = namespaces
dotnet_naming_rule.namespaces_pascal_case.style = pascal_case
dotnet_naming_rule.namespaces_pascal_case.severity = warning

dotnet_naming_symbols.namespaces.applicable_kinds = namespace
dotnet_naming_symbols.namespaces.applicable_accessibilities = *

# Rule 13: interfaces use an I prefix and PascalCase.
dotnet_naming_rule.interfaces_i_pascal_case.symbols = interfaces
dotnet_naming_rule.interfaces_i_pascal_case.style = i_pascal_case
dotnet_naming_rule.interfaces_i_pascal_case.severity = warning

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

# Rule 14: enums use an E prefix and PascalCase.
dotnet_naming_rule.enums_e_pascal_case.symbols = enums
dotnet_naming_rule.enums_e_pascal_case.style = e_pascal_case
dotnet_naming_rule.enums_e_pascal_case.severity = warning

dotnet_naming_symbols.enums.applicable_kinds = enum
dotnet_naming_symbols.enums.applicable_accessibilities = *

# Rule 16: private fields use an m prefix followed by PascalCase.
dotnet_naming_rule.private_fields_m_pascal_case.symbols = private_fields
dotnet_naming_rule.private_fields_m_pascal_case.style = m_pascal_case
dotnet_naming_rule.private_fields_m_pascal_case.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

#### Naming-style definitions ################################################

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.upper_snake_case.capitalization = all_upper
dotnet_naming_style.upper_snake_case.word_separator = _

dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

dotnet_naming_style.e_pascal_case.capitalization = pascal_case
dotnet_naming_style.e_pascal_case.required_prefix = E

dotnet_naming_style.m_pascal_case.capitalization = pascal_case
dotnet_naming_style.m_pascal_case.required_prefix = m

#### Generated code ###########################################################

[*.{Designer,designer,g,generated,g.i}.cs]
generated_code = true
dotnet_diagnostic.IDE1006.severity = none

