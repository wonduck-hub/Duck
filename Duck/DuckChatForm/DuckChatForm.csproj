<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <DuckChatCommonPlatform Condition="'$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU'">x64</DuckChatCommonPlatform>
    <DuckChatCommonPlatform Condition="'$(Platform)' == 'x86'">Win32</DuckChatCommonPlatform>
    <DuckChatCommonPlatform Condition="'$(Platform)' == 'x64'">x64</DuckChatCommonPlatform>
    <DuckChatCommonPlatform Condition="'$(Platform)' == 'ARM64'">ARM64</DuckChatCommonPlatform>
    <PlatformTarget Condition="'$(DuckChatCommonPlatform)' == 'Win32'">x86</PlatformTarget>
    <PlatformTarget Condition="'$(DuckChatCommonPlatform)' == 'x64'">x64</PlatformTarget>
    <PlatformTarget Condition="'$(DuckChatCommonPlatform)' == 'ARM64'">ARM64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PlatformTarget)' == 'x86'">win-x86</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PlatformTarget)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(PlatformTarget)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <DuckChatCommonProject>$(MSBuildThisFileDirectory)..\DuckChatServer\DuckChatCommon.vcxproj</DuckChatCommonProject>
    <DuckChatCommonDll>$(MSBuildThisFileDirectory)..\DuckChatServer\bin\Common\$(DuckChatCommonPlatform)\$(Configuration)\DuckChatCommon.dll</DuckChatCommonDll>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(DuckChatCommonDll)" Link="DuckChatCommon.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildDuckChatCommon" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(DuckChatCommonPlatform)' == ''" Text="Unsupported DuckChatForm platform: $(Platform). Use x86, x64, or ARM64." />
    <Error Condition="'$(RuntimeIdentifier)' != 'win-$(PlatformTarget)' and !('$(PlatformTarget)' == 'ARM64' and '$(RuntimeIdentifier)' == 'win-arm64')" Text="RuntimeIdentifier $(RuntimeIdentifier) does not match PlatformTarget $(PlatformTarget)." />
    <MSBuild Projects="$(DuckChatCommonProject)" Targets="Build" Properties="Configuration=$(Configuration);Platform=$(DuckChatCommonPlatform)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="winforms.datavisualization" Version="1.10.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="DuckChatForm.CustomControl\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>