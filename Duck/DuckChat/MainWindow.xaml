<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DuckChat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DuckChat">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <NavigationView
        x:Name="ServerNavigationView"
        PaneDisplayMode="LeftCompact"
        CompactPaneLength="72"
        OpenPaneLength="240"
        IsPaneOpen="False"
        IsSettingsVisible="False"
        IsBackButtonVisible="Collapsed"
        SelectionChanged="serverNavigationView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Direct Messages" Tag="Direct Messages" Icon="Contact" />
            <NavigationViewItemSeparator />
            <NavigationViewItem Content="Server1" Tag="DuckChat Community"  Icon="Message"/>
            <NavigationViewItem Content="Game Developers" Tag="Game Developers" Icon="Message" />
            <NavigationViewItem Content="Study Group" Tag="Study Group" Icon="Message" />
            <NavigationViewItem Content="Friends" Tag="Friends" Icon="Message" />
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Add a Server" Tag="Add a Server" Icon="Add" />
        </NavigationView.FooterMenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" BorderThickness="0,0,0,1">
                <TextBlock
                    x:Name="SelectedServerTitle"
                    Text="Direct Messages"
                    VerticalAlignment="Center"
                    Margin="20,0"
                    FontSize="16"
                    FontWeight="SemiBold" />
            </Border>

            <Grid Grid.Row="1" RowSpacing="12" Margin="20,12,20,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ScrollViewer
                        x:Name="MessageScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="MessageList" Spacing="16" />
                    </ScrollViewer>

                    <TextBlock
                        x:Name="EmptyMessageHint"
                        Text="아직 메시지가 없습니다. 대화를 시작해 보세요."
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="MessageInput"
                        Grid.Column="0"
                        PlaceholderText="메시지 입력..."
                        AcceptsReturn="False"
                        VerticalContentAlignment="Center"
                        KeyDown="messageInput_KeyDown" />
                    <Button
                        Grid.Column="1"
                        Content="전송"
                        Click="sendButton_Click" />
                </Grid>
            </Grid>
        </Grid>
    </NavigationView>
</Window>
