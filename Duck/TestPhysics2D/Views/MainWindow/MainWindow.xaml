<Window x:Class="WatermelonGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermelonGame"
        mc:Ignorable="d"
        Title="Watermellon Game!" Height="600" Width="900
        " WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--WPF Canvas는 게임엔진처럼 매 프레임을 새로 그리는 구조가 아님 내부 개체들을 업데이트 해줘야 하는 방식-->
        <!--WPF는 Retained Mode UI로 변경된 부분만 다시 렌더링 하는 것(성능 효율적)-->
        <Canvas Grid.Column="0" Grid.Row="0" Background="LightGray" x:Name="mainRenderngCanvas"
                PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp">

        </Canvas>

        <Grid Grid.Row="0" Grid.Column="1">
            <StackPanel>
                <Button Content="Reset"
                Click="ResetButton_Click"
                Background="Pink"
                Margin="5"/>
                <Separator/>

                <!--설정-->
                <TextBlock Text="Setting"
                           FontSize="20"
                           Margin="5"/>
                <TextBlock Text="Gravity"
                   Margin="5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GravityTextBox"
                 Margin="5"
                         Height="20"/>
                    <Button Grid.Column="1"
                            Content="Apply"
                            Click="ApplyGravityButton_Click"/>

                </Grid>

                <TextBlock Text="Image Folder Path"
                   Margin="5"/>

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ImageFolderPathTextBox"
                     Grid.Column="0"
                             Height="20"
                     IsReadOnly="True"/>

                    <Button Grid.Column="1"
                    Content="Browse"
                    Margin="5"
                    Click="BrowseImageFolderButton_Click"/>
                </Grid>
                <Separator/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <ComboBox x:Name="ComboBoxLevel"
                              Width="150"
                              SelectionChanged="SelectedLevelComboBoxItemChanged">
                        <ComboBoxItem>Level 1</ComboBoxItem>
                        <ComboBoxItem>Level 2</ComboBoxItem>
                        <ComboBoxItem>Level 3</ComboBoxItem>
                        <ComboBoxItem>Level 4</ComboBoxItem>
                        <ComboBoxItem>Level 5</ComboBoxItem>
                        <ComboBoxItem>Level 6</ComboBoxItem>
                        <ComboBoxItem>Level 8</ComboBoxItem>
                        <ComboBoxItem>Level 9</ComboBoxItem>
                        <ComboBoxItem>Level 10</ComboBoxItem>
                        <ComboBoxItem>Level 11</ComboBoxItem>
                        <ComboBoxItem>Level 12</ComboBoxItem>
                    </ComboBox>

                    <TextBox x:Name="TextBoxNewSize" Width="150" Margin="0, 0, 5, 0" />

                    <Button Content="레벨 크기 적용" Width="Auto" Margin="20, 0, 20, 0" Click="SetWatermellonSizeOfLevel"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
