<Window x:Class="WatermelonGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WatermelonGame"
        mc:Ignorable="d"
        Title="Watermellon Game!" Height="600" Width="900
        " WindowStyle="SingleBorderWindow" ResizeMode="CanMinimize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="400" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--WPF Canvas는 게임엔진처럼 매 프레임을 새로 그리는 구조가 아님 내부 개체들을 업데이트 해줘야 하는 방식-->
        <!--WPF는 Retained Mode UI로 변경된 부분만 다시 렌더링 하는 것(성능 효율적)-->
        <Canvas Grid.Column="0" Grid.Row="0" Background="LightGray" x:Name="mainRenderngCanvas"
                PreviewMouseLeftButtonUp="MainCanvas_PreviewMouseLeftButtonUp">

        </Canvas>

        <Grid Grid.Row="0" Grid.Column="1">
            <StackPanel>
                <Button Content="Reset"
                Click="ResetButton_Click"
                Background="Pink"
                Margin="5"/>
                <Separator/>

                <!--설정-->
                <TextBlock Text="Setting"
                           FontSize="20"
                           Margin="5"/>
                <TextBlock Text="Gravity"
                   Margin="5"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="GravityTextBox"
                 Margin="5"
                         Height="20"/>
                    <Button Grid.Column="1"
                            Content="Apply"
                            Click="ApplyGravityButton_Click"/>

                </Grid>

                <TextBlock Text="Image Folder Path"
                   Margin="5"/>

                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ImageFolderPathTextBox"
                     Grid.Column="0"
                             Height="20"
                     IsReadOnly="True"/>

                    <Button Grid.Column="1"
                    Content="Browse"
                    Margin="5"
                    Click="BrowseImageFolderButton_Click"/>
                </Grid>
                <Separator/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Level1: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level0TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level2: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level1TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level3: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level2TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level4: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level3TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level5: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level4TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level6: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level5TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level7: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level6TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <TextBlock Text="Level8: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level7TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level9: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level8TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level10: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level9TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level11: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level10TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <TextBlock Text="Level12: " VerticalAlignment="Center"/>
                    <TextBox x:Name="Level11TextBoxSize" Width="70" Margin="0, 0, 5, 0"/>
                    <Button Content="레벨 크기 적용" Width="Auto" Margin="20, 0, 20, 0" Click="ApplyWatermellonSize_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
